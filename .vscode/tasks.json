{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with install.sh",
            "type": "shell",
            "command": "./install.sh",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc",
                "$nvcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
