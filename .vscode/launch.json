{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug upside", // You can name this whatever you like
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/obj/upside", // Path to your executable
            "args": [
                "--duration", "1000",
                "--frame-interval", "50",
                "--temperature", "0.8",
                "--seed", "1",
                "${workspaceFolder}/example/01.GettingStarted/outputs/simple_test/chig.run.up" // Note: GDB might need absolute paths for files if relative paths cause issues
            ],
            "stopAtEntry": false, // Set to true if you want the debugger to stop at the beginning of main()
            "cwd": "${workspaceFolder}/tests/", // Current working directory for your program
            "environment": [],
            "externalConsole": false, // Set to true if you want a separate console window for your program's output
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel", // Optional, personal preference
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build with install.sh", // This task will run before debugging starts
            "miDebuggerPath": "/usr/bin/gdb" // Path to your GDB in WSL
        },
        {
            "name": "debug upside (CUDA)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/obj/upside",
            "args": [
                "--duration", "1000",
                "--frame-interval", "50",
                "--temperature", "0.8",
                "--seed", "1",
                "--cuda-acceleration",
                "${workspaceFolder}/example/01.GettingStarted/outputs/simple_test/chig.run.up"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/",
            "environment": [
                {
                    "name": "PATH",
                    "value": "/home/okleinmann/.miniconda3/envs/upside2-env/bin:${env:PATH}"
                },
                {
                    "name": "CUDA_LAUNCH_BLOCKING",
                    "value": "1"
                },
                {
                    "name": "CUDA_DEVICE_DEBUG",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set breakpoint pending",
                    "text": "-gdb-set breakpoint pending on",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable CUDA break on launch",
                    "text": "set cuda break_on_launch application",
                    "ignoreFailures": true
                },
                {
                    "description": "Set CUDA focus",
                    "text": "set cuda software_preemption on",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable CUDA memcheck",
                    "text": "set cuda memcheck on",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build with install.sh",
            "miDebuggerPath": "/usr/local/cuda-12.9/bin/cuda-gdb"
        }
    ]
}
