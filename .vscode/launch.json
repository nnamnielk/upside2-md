{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug upside (standard)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/obj/upside",
            "args": [
                "--duration", "1000",
                "--frame-interval", "50",
                "--temperature", "0.8",
                "--seed", "1",
                "${workspaceFolder}/example/01.GettingStarted/outputs/simple_test/chig.run.up"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/",
            "environment": [
                {
                    "name": "PATH",
                    "value": "/home/okleinmann/.miniconda3/envs/upside2-env/bin:${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set breakpoint pending",
                    "text": "-gdb-set breakpoint pending on",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "debug upside (CUDA - minimal)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/obj/upside",
            "args": [
                "--duration", "100",
                "--frame-interval", "10",
                "--temperature", "0.8",
                "--seed", "1",
                "--cuda-acceleration",
                "${workspaceFolder}/example/01.GettingStarted/outputs/simple_test/chig.run.up"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/",
            "environment": [
                {
                    "name": "PATH",
                    "value": "/home/okleinmann/.miniconda3/envs/upside2-env/bin:${env:PATH}"
                },
                {
                    "name": "CUDA_LAUNCH_BLOCKING",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set breakpoint pending",
                    "text": "-gdb-set breakpoint pending on",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/local/cuda-12.9/bin/cuda-gdb",
            "miDebuggerArgs": "--interpreter=mi2"
        },
        {
            "name": "debug upside (CUDA - device debugging)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/obj/upside",
            "args": [
                "--duration", "100",
                "--frame-interval", "10", 
                "--temperature", "0.8",
                "--seed", "1",
                "--cuda-acceleration",
                "${workspaceFolder}/example/01.GettingStarted/outputs/simple_test/chig.run.up"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/",
            "environment": [
                {
                    "name": "PATH",
                    "value": "/home/okleinmann/.miniconda3/envs/upside2-env/bin:${env:PATH}"
                },
                {
                    "name": "CUDA_LAUNCH_BLOCKING",
                    "value": "1"
                },
                {
                    "name": "CUDA_DEVICE_MAX_CONNECTIONS",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set breakpoint pending",
                    "text": "-gdb-set breakpoint pending on",
                    "ignoreFailures": true
                },
                {
                    "description": "Handle CUDA signals",
                    "text": "handle SIGPIPE nostop noprint",
                    "ignoreFailures": true
                },
                {
                    "description": "Handle SIGCONT signals",
                    "text": "handle SIGCONT nostop noprint pass",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable CUDA API debugging",
                    "text": "set cuda api_failures stop",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable CUDA break on launch",
                    "text": "set cuda break_on_launch application",
                    "ignoreFailures": true
                },
                {
                    "description": "Set CUDA focus",
                    "text": "set cuda software_preemption on",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable CUDA device debugging",
                    "text": "set cuda device_debugging on",
                    "ignoreFailures": true
                },
                {
                    "description": "Set CUDA memcheck off for better performance",
                    "text": "set cuda memcheck off",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/local/cuda-12.9/bin/cuda-gdb",
            "miDebuggerArgs": "--interpreter=mi2",
            "sourceFileMap": {
                "/proc/self/cwd": "${workspaceFolder}"
            }
        }
    ]
}
